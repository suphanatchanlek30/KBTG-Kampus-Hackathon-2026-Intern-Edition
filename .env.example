# Copy this file to .env. Never commit real secrets.

# ---- Backend (api) ----
# Docker Compose always uses the db service. Use this value for a local API process.
DATABASE_URL=postgres://ksure:ksure_dev_only@localhost:5432/ksure?sslmode=disable
PORT=8080
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
APP_TZ=Asia/Bangkok
INVITE_TTL=24h
EXPIRY_TICK=30s
DEMO_TOOLS_ENABLED=true
# Run migrations when the API starts. Disable to run make migrate manually.
MIGRATE_ON_START=true
# debug / info / warn / error
LOG_LEVEL=info
# Public frontend URL used to build invite QR links. Use the host LAN IP for device demos.
APP_BASE_URL=http://localhost:3000
# Session-cookie lifetime.
SESSION_TTL=12h
# Enable only for HTTPS deployments; secure cookies are sent over HTTPS only.
COOKIE_SECURE=false
# Start the demo clock at this time and advance it normally.
# DEMO_FROZEN_NOW=2026-10-14T10:40:00+07:00
