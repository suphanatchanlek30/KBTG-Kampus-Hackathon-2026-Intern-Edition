# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit .env จริง (ดู docs/03-architecture.md §3.6)

# ---- Backend (api) ----
# ใน docker compose ถูกบังคับให้ชี้ service db เสมอ — ค่านี้ใช้ตอนรัน api บนเครื่อง (make dev ตั้งให้เอง)
DATABASE_URL=postgres://ksure:ksure_dev_only@localhost:5432/ksure?sslmode=disable
PORT=8080
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
APP_TZ=Asia/Bangkok
INVITE_TTL=24h
EXPIRY_TICK=30s
DEMO_TOOLS_ENABLED=true
# รัน goose up ตอน api start (ปิดถ้าอยาก migrate เองด้วย make migrate)
MIGRATE_ON_START=true
# debug / info / warn / error
LOG_LEVEL=info
# อายุ cookie ล็อกอิน (ks_session)
SESSION_TTL=12h
# true เมื่อเปิดผ่าน HTTPS (tunnel / --experimental-https) — cookie จะถูกส่งเฉพาะ https
COOKIE_SECURE=false
# ให้นาฬิกาของระบบเริ่มที่เวลานี้แล้วเดินต่อ (เดโมตามสคริปต์วันที่ใน mockup)
# DEMO_FROZEN_NOW=2026-10-14T10:40:00+07:00
