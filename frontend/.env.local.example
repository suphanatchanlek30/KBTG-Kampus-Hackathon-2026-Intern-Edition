# คัดลอกเป็น frontend/.env.local (ดู docs/03-architecture.md §3.6)

# Backend ที่ Next.js rewrites /api/* ไปหา
API_ORIGIN=http://localhost:8080

# true = ใช้ mock data (เดโม UI อย่างเดียว เช่น Vercel) · false = เรียก API จริง (ต้อง make up ก่อน)
NEXT_PUBLIC_USE_MOCK=true

# แสดงป้าย "Prototype only · No real funds"
NEXT_PUBLIC_SHOW_DEMO_BADGE=true

# ระยะ polling (ms) หน้าสถานะดีล L5 / D8 — 2000 ให้จออีกเครื่องเห็นการเปลี่ยนแปลงภายใน 3 วินาที (รวมเวลาวาดหน้า)
NEXT_PUBLIC_POLL_MS=2000
