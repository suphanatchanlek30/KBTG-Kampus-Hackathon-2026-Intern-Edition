# Copy this file to frontend/.env.local.

# Backend origin used by the Next.js API rewrite.
API_ORIGIN=http://localhost:8080

# Use mock data when true. Set false after starting the local API stack.
NEXT_PUBLIC_USE_MOCK=true

# Display the prototype disclosure.
NEXT_PUBLIC_SHOW_DEMO_BADGE=true

# Deal-status polling interval in milliseconds.
NEXT_PUBLIC_POLL_MS=2000
